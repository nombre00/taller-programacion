# ============================================================
# GOLDEN BURGERS - VARIABLES DE ENTORNO
# ============================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Pídele las credenciales reales a Sofía (sofgomezdev-sudo)
# 3. NUNCA subas el archivo .env a GitHub (está en .gitignore)
# 4. NUNCA compartas las credenciales por email o chat público
#
# ============================================================


# ------------------------------------------------------------
# ORACLE DATABASE (Oracle Cloud Autonomous Database)
# ------------------------------------------------------------
# Usuario y password del schema de la aplicación
USERNAME=GOLDENBURGERSDB
PASSWORD=

# Ruta a la carpeta del Wallet (descargado de Oracle Cloud)
# La carpeta Wallet_GOLDENBURGER debe estar en la raíz del proyecto
TNS_ADMIN=Wallet_GOLDENBURGER


# ------------------------------------------------------------
# JWT SECRET
# ------------------------------------------------------------
# IMPORTANTE: Este valor DEBE ser exactamente el mismo en
# todos los microservicios. De lo contrario, los tokens
# generados por GestionUsuario no serán válidos en otros servicios.
JWT_SECRET=


# ------------------------------------------------------------
# MERCADO PAGO
# ------------------------------------------------------------
# Credenciales de Mercado Pago.
# Para desarrollo: usar credenciales de SANDBOX
# Para producción: cambiar por credenciales de PRODUCCIÓN
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=


# ------------------------------------------------------------
# FRONTEND URL (para CORS y redirecciones de Mercado Pago)
# ------------------------------------------------------------
# En desarrollo local
FRONTEND_URL=http://localhost:5173

# En producción será: https://goldenburger.cl
# FRONTEND_URL=https://goldenburger.cl
